# ============================================================
# Configurações de Integração com o GitHub
# ============================================================

# Repositório do GitHub no formato "dono/nome-do-repositório"
# Exemplo: GITHUB_REPO=facebook/react
# Usado para buscar Issues e Pull Requests relacionados aos erros de acessibilidade
GITHUB_REPO=dono/repositorio

# Token de Acesso Pessoal (PAT) do GitHub
# Opcional, mas recomendado para evitar limites de requisições (rate limiting)
# Como obter: GitHub → Settings → Developer Settings → Personal Access Tokens
# Permissões necessárias: apenas leitura pública (nenhuma permissão de escrita necessária)
GITHUB_TOKEN=seu_token_aqui_ex_ghp_xxxxxxxxx
